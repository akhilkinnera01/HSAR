FROM python:3.10-slim AS proto-builder

WORKDIR /src
COPY signal-engine/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY proto/ /src/proto/
RUN python3 -m grpc_tools.protoc -I proto \
    --python_out=gen/python \
    --grpc_python_out=gen/python \
    proto/hsar/v1/*.proto

FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY signal-engine/requirements.txt /app/signal-engine/requirements.txt
RUN pip install --no-cache-dir -r /app/signal-engine/requirements.txt

COPY signal-engine/ /app/signal-engine/
COPY --from=proto-builder /src/gen/python/ /app/gen/python/

ENV PYTHONPATH=/app/gen/python

EXPOSE 50051
CMD ["python3", "-u", "signal-engine/main.py"]