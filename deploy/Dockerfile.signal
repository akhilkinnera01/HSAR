FROM python:3.10-slim

WORKDIR /app

# Copy requirements and install
COPY signal-engine/requirements.txt /app/signal-engine/requirements.txt
RUN pip install --no-cache-dir -r /app/signal-engine/requirements.txt

# Copy server code
COPY signal-engine/ /app/signal-engine/

# Copy generated protobuf bindings from repo root
COPY gen/python/ /app/gen/python/

# Make generated code importable
ENV PYTHONPATH=/app/gen/python:/app/signal-engine

EXPOSE 50051
CMD ["python3", "/app/signal-engine/main.py"]
