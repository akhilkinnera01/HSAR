# Runtime Stage (Python Slim)
FROM python:3.10-slim

WORKDIR /app

# Install System Dependencies (Minimal)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY signal-engine/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy Code & Generated Contracts
COPY signal-engine/ .
# Note: In Step 1 we generated python code into signal-engine/gen/python
# We ensure the container can see it
COPY signal-engine/gen/python/ ./gen/python/

# Ensure generated code is importable
ENV PYTHONPATH="${PYTHONPATH}:/app/gen/python"

CMD ["python", "main.py"]