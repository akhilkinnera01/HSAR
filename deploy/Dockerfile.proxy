# Build Stage
FROM golang:1.25-alpine AS builder
WORKDIR /app

RUN apk add --no-cache curl git
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.5 && \
    go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.5.1
RUN curl -sSL "https://github.com/bufbuild/buf/releases/download/v1.71.0/buf-Linux-$(uname -m)" \
    -o /usr/local/bin/buf && chmod +x /usr/local/bin/buf

ENV PATH="/go/bin:${PATH}"

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN mkdir -p gen/go && buf lint && buf generate
RUN CGO_ENABLED=0 GOOS=linux go build -o /bin/proxy cmd/proxy/main.go

# Runtime Stage (Distroless / Scratch)
FROM scratch
COPY --from=builder /bin/proxy /bin/proxy
COPY --from=builder /app/policies /policies
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
ENV POLICY_PATH=/policies/standard-safety-policy.yaml
ENTRYPOINT ["/bin/proxy"]